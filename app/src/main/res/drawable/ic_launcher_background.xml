<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Deep Stadium Sports Blue Base -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0.0" android:color="#0B132B" />
                <item android:offset="0.5" android:color="#1C2541" />
                <item android:offset="1.0" android:color="#3A506B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing Stadium Light Aura (Centered radial glow) -->
    <path android:pathData="M54,54m-45,0a45,45 0,1 1,90 0a45,45 0,1 1,-90 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="45"
                android:type="radial">
                <item android:offset="0.0" android:color="#304285F4" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Stadium abstract structural beam lights representing arena -->
    <path
        android:pathData="M10,108 L40,0 L45,0 L12,108 Z"
        android:fillColor="#0EFFFFFF" />
    <path
        android:pathData="M98,108 L68,0 L63,0 L96,108 Z"
        android:fillColor="#0EFFFFFF" />
    <path
        android:pathData="M0,45 L108,55 L108,57 L0,47 Z"
        android:fillColor="#08FFFFFF" />
</vector>
